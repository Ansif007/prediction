rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && 
        // Prevent users from changing their own role or totalPoints
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'totalPoints'])
      );
      allow delete: if isAdmin();
    }

    // Matches
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Predictions
    match /predictions/{predictionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.uid == request.auth.uid &&
        // Verify match exists, is upcoming, and kickoff has not passed
        get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'upcoming' &&
        get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.kickoffTime > request.time + duration.value(1, 'm');
      
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.uid == request.auth.uid &&
        // Only allow update if match is still upcoming and kickoff has not passed
        get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.status == 'upcoming' &&
        get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.kickoffTime > request.time + duration.value(1, 'm') &&
        // Prevent users from changing the uid or matchId
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.matchId == resource.data.matchId
      );
      
      allow delete: if isAdmin();
    }

    // Notices
    match /notices/{noticeId} {
      allow read: if isSignedIn() || true; // Publicly readable for home page
      allow write: if isAdmin();
    }

    // Global app configuration
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Round leaderboard caches
    match /roundResults/{roundId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /roundWinners/{roundId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
