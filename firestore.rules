rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      // Users can read other user profiles (for leaderboard)
      allow read: if request.auth != null;
      
      // Users can only create their own profile initially
      // Admins can update any user (e.g., awarding points)
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- MATCHES COLLECTION ---
    match /matches/{matchId} {
      // Everyone logged in can see matches
      allow read: if request.auth != null;
      
      // Only admins can create/update/delete matches
      allow write: if isAdmin();
    }

    // --- PREDICTIONS COLLECTION ---
    match /predictions/{predictionId} {
      // Users can only read their own predictions
      // Admins can read all predictions to calculate points
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());

      // Create/Update Prediction Security
      allow create, update: if request.auth != null 
        && request.auth.uid == request.resource.data.uid
        && !isAdmin() // Admins restricted from participating as per UI rules
        && isBeforeCutoff(request.resource.data.matchId);
    }

    // Helper function to verify prediction is made 10+ mins before kickoff
    function isBeforeCutoff(matchId) {
      let kickoff = get(/databases/$(database)/documents/matches/$(matchId)).data.kickoffTime;
      // kickoff is a Firestore Timestamp
      return request.time < kickoff - duration.value(10, 'm');
    }
  }
}
